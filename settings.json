{
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(touch:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/checkpoint-restore.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/repo-setup.cjs\"",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/worktree-sweep.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/edit-gate.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking edit gate..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/commit-gate.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking commit gate..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/plan-gate.cjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gate-arm.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/diff-record.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_.+_)?serena__(find_referencing_symbols|find_implementations|find_declaration)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/refs-record.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/verify-record.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/plan-audit-record.cjs\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__(plugin_.+_)?serena__(find_referencing_symbols|find_implementations|find_declaration)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/refs-record.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/discipline-reminder.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/verify-gate.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/checkpoint-write.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/agent-log.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/agent-log.cjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gates/plan-audit-record.cjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/verify-record.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": true,
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "verbose": false,
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "claudeCode.useCtrlEnterToSend": true,
  "inputNeededNotifEnabled": true,
  "enableWorkflows": false
}
